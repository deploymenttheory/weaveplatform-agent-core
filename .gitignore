# macOS
.DS_Store

# VSCode
.vs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Build and temp files
/build/
/tmp/
*.log
*.bak

# Windows-specific 
*.winfile eol=crlf

# Go development
*.test
/vendor/
/bin/
/dist/
/pkg/
coverage.out
coverage.html

# Python virtual environments
scripts/python/venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
*.egg-info/

# AI instructions
.claude
.cursor

# Binaries and executables
*.dll
*.exe
*.dylib
*.so
# goreleaser output
dist/

# lint/CI artifacts (never commit)
*.sarif
golangci-lint-report.sarif

# Local multi-module workspace. Never committed: CI and goreleaser must build
# from the recorded go.mod pins, and a tracked workspace would mask a stale one.
go.work
go.work.sum
